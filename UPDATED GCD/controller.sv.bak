// synthesis message_off 10175

`timescale 1ns/1ns

module controller (
    input rst, input clk, input go_i, input x_lt_y, input x_neq_y,
    output x_ld, output y_ld, output x_sel, output y_sel, output d_ld);

    enum int unsigned { state1=0, state3=1, state4=2, state5=3, state6=4, state2=5 } fstate, reg_fstate;

    always_ff @(posedge clk)
    begin
        if (clk) begin
            fstate <= reg_fstate;
        end
    end

    always_comb begin
        if (rst) begin
            reg_fstate <= state1;
            x_ld <= 1'b0;
            y_ld <= 1'b0;
            x_sel <= 1'b0;
            y_sel <= 1'b0;
            d_ld <= 1'b0;
        end
        else begin
            x_ld <= 1'b0;
            y_ld <= 1'b0;
            x_sel <= 1'b0;
            y_sel <= 1'b0;
            d_ld <= 1'b0;
            case (fstate)
                state1: begin
                    if (go_i)
                        reg_fstate <= state2;
                    else if (~(go_i))
                        reg_fstate <= state1;
                    // Inserting 'else' block to prevent latch inference
                    else
                        reg_fstate <= state1;

                    x_ld <= 1'b0;

                    y_sel <= 1'b0;

                    y_ld <= 1'b0;

                    x_sel <= 1'b0;
                end
                state3: begin
                    if ((x_neq_y & ~(x_lt_y)))
                        reg_fstate <= state4;
                    else if ((x_neq_y & x_lt_y))
                        reg_fstate <= state5;
                    else if (~(x_neq_y))
                        reg_fstate <= state6;
                    // Inserting 'else' block to prevent latch inference
                    else
                        reg_fstate <= state3;

                    d_ld <= 1'b0;

                    x_ld <= 1'b0;

                    y_ld <= 1'b0;
                end
                state4: begin
                    reg_fstate <= state3;

                    x_ld <= 1'b1;

                    x_sel <= 1'b1;
                end
                state5: begin
                    reg_fstate <= state3;

                    y_sel <= 1'b1;

                    y_ld <= 1'b1;
                end
                state6: begin
                    if (~(go_i))
                        reg_fstate <= state1;
                    else if (go_i)
                        reg_fstate <= state2;
                    // Inserting 'else' block to prevent latch inference
                    else
                        reg_fstate <= state6;

                    d_ld <= 1'b1;
                end
                state2: begin
                    reg_fstate <= state3;

                    x_ld <= 1'b1;

                    y_sel <= 1'b0;

                    y_ld <= 1'b1;

                    x_sel <= 1'b0;
                end
                default: begin
                    x_ld <= 1'bx;
                    y_ld <= 1'bx;
                    x_sel <= 1'bx;
                    y_sel <= 1'bx;
                    d_ld <= 1'bx;
                    $display ("Reach undefined state");
                end
            endcase
        end
    end
endmodule // controller
